network duplicate_neuron_test {

    inputs {
        x;
    }

    layer hidden activation relu {

        neuron a {
            x weight 1.00;
            bias 0.00;
        }

        neuron a {
            x weight 0.50;
            bias 0.00;
        }
    }

    layer output activation step {

        neuron result {
            a weight 1.00;
            bias 0.00;
        }
    }
}

predict duplicate_neuron_test with {
    x = 1.00;
}