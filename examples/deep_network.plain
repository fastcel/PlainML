network deep_test {

    inputs {
        x;
        y;
    }

    layer hidden1 activation relu {

        neuron a {
            x weight 0.50;
            y weight 0.50;
            bias 0.00;
        }
    }

    layer hidden2 activation relu {

        neuron b {
            a weight 2.00;
            bias -0.50;
        }
    }

    layer output activation step {

        neuron result {
            b weight 1.00;
            bias -0.50;
        }
    }
}

predict deep_test with {
    x = 1.00;
    y = 1.00;
}